# Copie este arquivo para ".env" e ajuste. NUNCA envie o ".env" ao Git.

# Chave de sessão. Se vazio, é gerada automaticamente em instance/secret_key.txt
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Chave que criptografa as senhas dos clientes. Se vazio, é gerada em instance/fernet.key
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FAÇA BACKUP: sem ela as senhas guardadas não podem ser recuperadas.
FERNET_KEY=

# Primeiro administrador (criado só se não existir nenhum usuário).
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é exibida no terminal na 1ª execução.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Perfis autorizados a revelar a senha de clientes (separados por vírgula): admin, operador
REVEAL_ROLES=admin

# Banco SQLite (padrão: instance/gestao.db)
# DATABASE_PATH=

# Sessão: minutos de inatividade e cookie seguro (use 1 apenas com HTTPS)
SESSION_MINUTES=30
SESSION_COOKIE_SECURE=0

# Bloqueio de força bruta no login
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MIN=15

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
